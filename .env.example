# ==============================================================================
# RenewalDesk — Environment Configuration
# Copy this file to .env.local and populate with your Supabase project credentials.
# ==============================================================================

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Public API Key (safe for browser client-side usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Supabase Service Role Key (ONLY for trusted server-side tasks or migrations; NEVER expose in browser code!)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Application Base URL (for OAuth callbacks & magic link redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# In production: NEXT_PUBLIC_SITE_URL=https://renewaldesk.chronyx.in

# Optional: Razorpay Payment Gateway (required only if billing is enabled)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Optional: Razorpay Custom Checkout Configuration ID (custom checkout theme & payment method ordering)
# NEXT_PUBLIC_RAZORPAY_CONFIG_ID=config_...
